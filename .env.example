# ==========================================
# CallMus — variables de entorno (copiar a .env y rellenar)
# NUNCA subas el archivo .env real al repositorio.
# ==========================================

# Clave para firmar las cookies de sesión de Flask.
# Genera una aleatoria con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Envío de correos (verificación y recuperación de contraseña) ---
# Cuenta de Gmail emisora y su CONTRASEÑA DE APLICACIÓN de 16 letras
# (NO la contraseña normal). Requiere tener la verificación en 2 pasos activada.
SMTP_USER=callmus.contact@gmail.com
SMTP_PASS=
# Opcionales (valores por defecto para Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Login con Google (OAuth) ---
# Credenciales de un "ID de cliente de OAuth 2.0" creado en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Diagnóstico de salas (opcional) ---
# Si se define, habilita GET /api/debug/salas?token=... con el estado interno de
# las salas y los jugadores conectados (salas activas, edad, inactividad,
# huérfanos). Sin esta variable el endpoint devuelve 404. Déjala vacía salvo que
# estés depurando; cuando exista el panel de administración (#13) se sustituirá.
DEBUG_TOKEN=

# --- Panel de administración (Roadmap #13) ---
# Cuenta que se promueve a administradora al arrancar el servidor. Es la única
# forma de crear el PRIMER administrador; a partir de ahí se otorga el acceso
# desde el propio panel (/admin → Cuentas). Puedes dejarla vacía una vez creado.
ADMIN_USERNAME=

# --- Analítica de uso (Roadmap #24) ---
# Medición de audiencia propia y SIN COOKIES (no guarda nada en el dispositivo del
# visitante, así que el juego no necesita banner de consentimiento). Funciona sin
# tocar nada; estas dos variables solo están para afinarla.
# Fichero de la base de datos de analítica (separada de mus.db a propósito).
ANALYTICS_DB=analitica.db
# Días que se conservan las filas CRUDAS antes de purgarlas. Los agregados diarios
# no caducan, así que las series largas del panel se mantienen igualmente.
ANALYTICS_RETENCION_DIAS=90

# --- Endurecimiento (Roadmap #16) ---
# TODO ESTO FUNCIONA SIN TOCAR NADA. Las variables solo están para desactivar
# alguna protección si diera guerra en producción, sin tener que editar código:
# se cambia el valor, se reinicia y listo. Ver seguridad.py y
# tools/nginx-callmus.conf.
#
# Orígenes que pueden abrir el WebSocket. Vacío = callmus.com, www.callmus.com y
# localhost. Se puede poner una lista separada por comas, o un * para volver al
# comportamiento antiguo (aceptar a cualquiera).
# CORS_ORIGINS=
# Política de contenido: enforce (bloquea), report (solo avisa en la consola del
# navegador, útil para probar un cambio en las páginas) u off.
# CSP_MODO=enforce
# Límite de intentos en /auth/*. Ponlo a 0 para desactivarlo.
# LIMITES_ACTIVOS=1
# Proxies de confianza delante (nginx = 1). A 0 se ignoran las cabeceras
# X-Forwarded-*, que es lo correcto solo si el servidor se expone directamente.
# PROXIES_DE_CONFIANZA=1
# Tratar todas las peticiones como HTTPS aunque el proxy no mande
# X-Forwarded-Proto. Mejor arreglar nginx que activar esto.
# FORZAR_HTTPS=0
# Duración de la cabecera HSTS en segundos (180 días). A 0 no se manda.
# HSTS_MAX_AGE=15552000
# Copia diaria de mus.db y analitica.db, con rotación. Las hace el propio
# servidor: no hay que montar ningún cron.
# BACKUP_ACTIVO=1
# BACKUP_DIR=backups
# BACKUP_COPIAS=7
