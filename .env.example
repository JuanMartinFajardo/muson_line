# ==========================================
# CallMus — variables de entorno (copiar a .env y rellenar)
# NUNCA subas el archivo .env real al repositorio.
# ==========================================

# Clave para firmar las cookies de sesión de Flask.
# Genera una aleatoria con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Envío de correos (verificación y recuperación de contraseña) ---
# Cuenta de Gmail emisora y su CONTRASEÑA DE APLICACIÓN de 16 letras
# (NO la contraseña normal). Requiere tener la verificación en 2 pasos activada.
SMTP_USER=callmus.contact@gmail.com
SMTP_PASS=
# Opcionales (valores por defecto para Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Login con Google (OAuth) ---
# Credenciales de un "ID de cliente de OAuth 2.0" creado en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
